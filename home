});

/* ✅ CHECKOUT */
app.post("/api/checkout", async (req, res) => {
  try {
    const userId = 1; // Replace with actual logged-in user

    // Get cart items
    const cartRes = await pool.query(`
      SELECT cart.id, cart.product_id, products.name, products.price, cart.quantity
      FROM cart
      JOIN products ON cart.product_id = products.id
    `);

    if (cartRes.rows.length === 0) return res.status(400).json({ error: "Cart is empty" });

    const cartItems = cartRes.rows;

    // Calculate total
    const total = cartItems.reduce((sum, item) => sum + parseFloat(item.price) * item.quantity, 0);

    // Create order
    const orderRes = await pool.query(
      "INSERT INTO orders(user_id, total) VALUES($1, $2) RETURNING id",
      [userId, total]
    );
    const orderId = orderRes.rows[0].id;

    // Insert order items
    for (const item of cartItems) {
      await pool.query(
        "INSERT INTO order_items(order_id, product_id, quantity, price) VALUES($1, $2, $3, $4)",
        [orderId, item.product_id, item.quantity, item.price]
      );
    }

    // Empty cart
    await pool.query("DELETE FROM cart");

    // Return order summary to frontend
    res.json({
      orderId,
      items: cartItems.map(i => ({
        name: i.name,
        quantity: i.quantity,
        price: i.price
      })),
      total
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Checkout failed" });
  }
});

