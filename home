const express = require("express");
const session = require("express-session");
const bcrypt = require("bcrypt");
const pgSession = require("connect-pg-simple")(session);
const pool = require("./db");

const app = express();
app.use(express.json());
app.use(express.static("public"));

app.use(
  session({
    store: new pgSession({
      pool: pool,
      tableName: "session"
    }),
    secret: "supersecretkey",
    resave: false,
    saveUninitialized: false,
  })
);

/* ✅ REGISTER */
app.post("/api/register", async (req, res) => {
  const { username, password } = req.body;
  const hash = await bcrypt.hash(password, 10);

  try {
    await pool.query(
      "INSERT INTO users (username, password) VALUES ($1, $2)",
      [username, hash]
    );
    res.sendStatus(200);
  } catch {
    res.status(400).send("User already exists");
  }
});

/* ✅ LOGIN */
app.post("/api/login", async (req, res) => {
  const { username, password } = req.body;

  const result = await pool.query(
  "SELECT id, username, password, is_admin FROM users WHERE username = $1",
  [username]
  );

  if (result.rows.length === 0) return res.status(401).send("Invalid login");

  const user = result.rows[0];
  const valid = await bcrypt.compare(password, user.password);

  if (!valid) return res.status(401).send("Invalid login");

  req.session.userId = user.id;
  res.sendStatus(200);
});

function requireAdmin(req, res, next) {
  if (!req.session.user || !req.session.user.is_admin) {
    return res.status(403).send("Admin only");
  }
  next();
}

/* ✅ LOGOUT */
app.post("/api/logout", (req, res) => {
  req.session.destroy();
  res.sendStatus(200);
});

/* ✅ CHECK LOGIN */
app.get("/api/me", (req, res) => {
  if (!req.session.userId) return res.json(null);
  res.json({ userId: req.session.userId });
});

/* ✅ ADMIN CHECK */
async function adminOnly(req, res, next) {
  if (!req.session.userId) return res.sendStatus(401);

  const result = await pool.query(
    "SELECT is_admin FROM users WHERE id = $1",
    [req.session.userId]
  );

  if (!result.rows[0]?.is_admin) return res.sendStatus(403);
  next();
}

