/* ✅ ADD TO CART */
app.post("/api/cart", async (req, res) => {
  const userId = req.session.userId;
  const { product_id } = req.body;

  const existing = await pool.query(
    "SELECT * FROM cart WHERE product_id = $1 AND user_id = $2",
    [product_id, userId]
  );

  if (existing.rows.length > 0) {
    await pool.query(
      "UPDATE cart SET quantity = quantity + 1 WHERE product_id = $1 AND user_id = $2",
      [product_id, userId]
    );
  } else {
    await pool.query(
      "INSERT INTO cart (product_id, quantity, user_id) VALUES ($1, 1, $2)",
      [product_id, userId]
    );
  }

  res.sendStatus(200);
});

/* ✅ VIEW CART */
app.get("/api/cart", async (req, res) => {
  const userId = req.session.userId;

  const result = await pool.query(`
    SELECT cart.id, products.name, products.price, cart.quantity
    FROM cart
    JOIN products ON cart.product_id = products.id
    WHERE cart.user_id = $1
  `, [userId]);

  res.json(result.rows);
});

/* ✅ REMOVE FROM CART */
app.delete("/api/cart/:id", async (req, res) => {
  const userId = req.session.userId;

  const result = await pool.query(
    "SELECT quantity FROM cart WHERE id = $1 AND user_id = $2",
    [req.params.id, userId]
  );
  if (result.rows.length === 0) return res.sendStatus(404);

  const quantity = result.rows[0].quantity;
  if (quantity > 1) {
    await pool.query(
      "UPDATE cart SET quantity = quantity - 1 WHERE id = $1 AND user_id = $2",
      [req.params.id, userId]
    );
  } else {
    await pool.query(
      "DELETE FROM cart WHERE id = $1 AND user_id = $2",
      [req.params.id, userId]
    );
  }

  res.sendStatus(200);
});

