APP_NAME="FLIGALIGA Vault"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Europe/Amsterdam
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

LOG_CHANNEL=stack
LOG_LEVEL=info

# Local development only: this is a fresh Laravel SQLite file.
# It is separate from the original Node/PostgreSQL recovery database.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Online payments are intentionally disabled while the storefront is unfinished.
PAYMENTS_ENABLED=false
MOLLIE_API_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Email delivery is deliberately unconfigured until the owner is ready.
RESEND_API_KEY=
RESEND_FROM=
CONTACT_RECIPIENT=fligaliga@hotmail.com
GA_MEASUREMENT_ID=
