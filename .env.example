# MySQL target used by the application (requires MySQL 8.0.16+).
# Keep the source PostgreSQL settings below separate until data migration is verified.
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_DATABASE=fligaliga
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_CONNECTION_LIMIT=10
# Set true if the host requires TLS; certificate verification stays enabled by default.
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
# MYSQL_TIMEZONE=local

# PostgreSQL source used by the schema-export and data-migration scripts only.
DB_USER=your_postgres_user
DB_HOST=your_postgres_host
DB_NAME=your_postgres_database
DB_PASS=your_postgres_password
DB_PORT=5432
# Optional PostgreSQL connection string (preferred when supplied):
# DATABASE_URL=postgresql://user:password@host:5432/database

# Production payments
PAYMENTS_ENABLED=false
# Reservation window for unpaid checkouts (minutes, 10-120)
PAYMENT_RESERVATION_MINUTES=30
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_BASE_URL=https://www.example.com
SESSION_SECRET=replace-this-with-a-long-random-secret

# Transactional email
# Use a verified sender address/domain in Resend for production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=FLIGALIGA <verified-sender@example.com>
CONTACT_RECIPIENT=fligaliga@hotmail.com

# Optional analytics — only loaded after visitor consent
GA_MEASUREMENT_ID=G-9M2C7XHPW0
