# Copy this file to .env and keep your real credentials local.
DB_USER=your_user
DB_HOST=localhost
DB_NAME=webshop
DB_PASS=your_password
DB_PORT=5432
# Optional single connection string (used if DB_* values are not set):
# DATABASE_URL=postgresql://user:password@host:5432/database

# Production payments
PAYMENTS_ENABLED=false
# Reservation window for unpaid checkouts (minutes, 10-120)
PAYMENT_RESERVATION_MINUTES=30
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_BASE_URL=https://www.example.com
SESSION_SECRET=replace-this-with-a-long-random-secret

# Transactional email
# Use a verified sender address/domain in Resend for production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=FLIGALIGA <verified-sender@example.com>
CONTACT_RECIPIENT=fligaliga@hotmail.com

# Optional analytics — only loaded after visitor consent
GA_MEASUREMENT_ID=G-XXXXXXXXXX
