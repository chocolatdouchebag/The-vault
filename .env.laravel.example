APP_NAME="FLIGALIGA Vault"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Europe/Amsterdam
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

LOG_CHANNEL=stack
LOG_LEVEL=info

# Use the exact MySQL/MariaDB engine and version provided by the STRATO package.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fligaliga
DB_USERNAME=replace_me
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

PAYMENTS_ENABLED=false
MOLLIE_API_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:8000

RESEND_API_KEY=
RESEND_FROM=
CONTACT_RECIPIENT=fligaliga@hotmail.com
GA_MEASUREMENT_ID=
