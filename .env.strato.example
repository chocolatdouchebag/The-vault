# Reference only. Fill in values from the STRATO control panel in a PRIVATE .env.
# Never upload this example file as the real environment file.
APP_NAME="FLIGALIGA Vault"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fligaliga.nl
APP_TIMEZONE=Europe/Amsterdam
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Choose the driver appropriate to the actual STRATO database engine/version.
# A disposable staging database must pass the migration and feature-test checks first.
DB_CONNECTION=mysql
DB_HOST=replace_with_strato_db_host
DB_PORT=3306
DB_DATABASE=replace_with_database_name
DB_USERNAME=replace_with_database_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# If STRATO requires a custom TLS CA, configure MYSQL_ATTR_SSL_CA after validation.

# Confirm storage writability/session behavior for the actual hosting plan.
SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Keep disabled until Mollie is available and the complete payment lifecycle is tested.
PAYMENTS_ENABLED=false
MOLLIE_API_KEY=
PUBLIC_BASE_URL=https://fligaliga.nl

# Keep empty until email provider/sender configuration has been deliberately set up.
RESEND_API_KEY=
RESEND_FROM=
CONTACT_RECIPIENT=fligaliga@hotmail.com
GA_MEASUREMENT_ID=
